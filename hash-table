#include <iostream>
#include <string>

using namespace std;

typedef std::string Key;

struct Value {
    unsigned age = 0;
    unsigned weight = 0;
};

// Узел цепочки
struct Node {
    Key key;
    Value value;
    Node* next;

    Node(const Key& k, const Value& v) : key(k), value(v), next(nullptr) {}
};

class HashTable {
private:
    Node** table;
    size_t capacity;
    size_t count;

    
    size_t hash(const Key& key) const {
        long sum = 0;
        for (size_t i = 0; i < key.length(); ++i) {
            sum += key[i] * (i + 1);
        }
        if (sum < 0) sum = -sum;       
        return static_cast<size_t>(sum) % capacity; 
    }

public:
    HashTable(size_t cap = 32) : capacity(cap), count(0) {
        table = new Node*[capacity]();
    }

    ~HashTable() {
        clear();
        delete[] table;
    }

    void clear() {
        for (size_t i = 0; i < capacity; ++i) {
            Node* cur = table[i];
            while (cur) {
                Node* tmp = cur;
                cur = cur->next;
                delete tmp;
            }
            table[i] = nullptr;
        }
        count = 0;
    }

    void add(const Key& key, const Value& value) {
        size_t idx = hash(key);
        Node* cur = table[idx];
        while (cur) {
            if (cur->key == key) {
                cur->value = value;
                return;
            }
            cur = cur->next;
        }
        Node* node = new Node(key, value);
        node->next = table[idx];
        table[idx] = node;
        ++count;
    }

    bool erase(const Key& key) {
        size_t idx = hash(key);
        Node* cur = table[idx];
        Node* prev = nullptr;

        while (cur) {
            if (cur->key == key) {
                if (prev == nullptr)
                    table[idx] = cur->next;
                else
                    prev->next = cur->next;
                delete cur;
                --count;
                return true;
            }
            prev = cur;
            cur = cur->next;
        }
        return false;
    }

    Value* get(const Key& key) {
        size_t idx = hash(key);
        Node* cur = table[idx];
        while (cur) {
            if (cur->key == key) return &cur->value;
            cur = cur->next;
        }
        return nullptr;
    }
};


int main() {
    HashTable students;

    students.add("Alice", {33, 78});
    students.add("Bob", {88, 7090});
    students.add("Charlie", {19, 65});

    if (Value* v = students.get("Bob"))
        cout << "Bob найден: age=" << v->age << ", weight=" << v->weight << endl;

    students.erase("Alice");

    if (students.get("Alice") == nullptr)
        cout << "Alice успешно удалена" << endl;

    return 0;
}

